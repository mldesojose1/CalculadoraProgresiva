# ============================================================
#  .gitignore — Calculadora Antigravity
#  Solo se suben a GitHub Pages los archivos necesarios:
#  index.html · style.css · script.js · README.md
# ============================================================

# ── Archivos de desarrollo / internos ───────────────────────
# Versión de producción (ya está inlineada en index.html)
calculadora-pro.html

# Documentos de planificación interna
implementation_plan.md
walkthrough.md
task.md

# ── Sistema Operativo — Windows ─────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Sistema Operativo — macOS ────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editores de código ───────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ── Node.js (por si se agrega un bundler en el futuro) ───────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm
.pnp.*

# ── Herramientas de build ────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/
.vite/

# ── Variables de entorno ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ────────────────────────────────────────────────────
logs/
*.log

# ── Archivos temporales ──────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
